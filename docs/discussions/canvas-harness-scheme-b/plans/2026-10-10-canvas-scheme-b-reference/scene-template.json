        "labeled_attachment",
        "template_asset"
      ],
      "defaultAssetKey": "actor.neon-default.v1",
      "userRequiredWhen": "request_requires_specific_real_person_identity",
      "clarifyWhen": [
        "specific_identity_required_without_material",
        "ambiguous_attachment_role"
      ],
      "showSource": true
