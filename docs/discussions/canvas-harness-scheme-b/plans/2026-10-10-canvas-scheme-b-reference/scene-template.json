  "parameterPolicies": {
    "reference_product_image": {
      "capabilityProfile": "reference_product_image",
      "requiredModelMode": "reference_image_to_image",
      "businessDefaults": {
        "aspectRatio": "9:16",
        "imageQuality": "balanced",
        "outputCount": 1
      },
      "inputConstraints": {
        "minImages": 1,
        "maxImages": "defined_by_environment_profile"
      },
      "serializer": "configured_model_mode_serializer",
      "modelChoice": "explicit_valid_user_choice_else_published_profile",
      "fallback": "configured_semantically_compatible_only"
    },
    "two_frame_video": {
      "capabilityProfile": "two_frame_video",
      "requiredModelMode": "first_last_frame_to_video",
      "businessDefaults": {
        "videoQuality": "balanced",
        "outputCount": 1
      },
      "inputConstraints": {
        "roles": [
          "first_frame",
          "last_frame"
        ],
        "imageCount": 2,
        "noVideoOrAudioInputs": true
      },
      "serializer": "configured_model_mode_serializer",
      "durationResolution": "valid_generated_duration_then_explicit_local_trim_if_needed",
      "durationPlanning": "allocate_shot_timeline_resolve_legal_generated_duration_then_trim_unachievable_length_returns_business_difference"
    },
    "single_image_video": {
      "capabilityProfile": "single_image_video",
      "requiredModelMode": "image_to_video",
      "businessDefaults": {
        "videoQuality": "balanced",
        "outputCount": 1
      },
      "inputConstraints": {
        "roles": [
          "image"
        ],
        "imageCount": 1,
        "noVideoOrAudioInputs": true
      },
      "serializer": "configured_model_mode_serializer",
      "durationResolution": "valid_generated_duration_then_explicit_local_trim_if_needed",
      "durationPlanning": "allocate_shot_timeline_resolve_legal_generated_duration_then_trim_unachievable_length_returns_business_difference"
