+export type WorkflowTabStatus = 'checking' | 'active' | 'inactive';
+interface Owner { tabId: string; claimId: string; claimedAt: number }
+type Message = { type: 'query' } | { type: 'claim' | 'owner'; owner: Owner };
+const compare = (a: Owner, b: Owner) => a.claimedAt - b.claimedAt || a.claimId.localeCompare(b.claimId);
+
+/** Native latest-claim ownership; background services query before claiming. */
+export function createWorkflowTabOwnership(workflowId: string, onStatus: (status: WorkflowTabStatus) => void, background = false) {
+  let status: WorkflowTabStatus = 'checking';
+  let owner: Owner | null = null;
+  let self: Owner | null = null;
+  let disposed = false;
+  let channel: BroadcastChannel | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let resolveReady!: () => void;
+  const ready = new Promise<void>(resolve => { resolveReady = resolve; });
+  const supported = typeof window !== 'undefined' && typeof window.BroadcastChannel !== 'undefined';
+  const query = () => channel?.postMessage({ type: 'query' } satisfies Message);
+  const visible = () => { if (document.visibilityState === 'visible') query(); };
+  const stopListening = () => {
+    clearTimeout(timer);
+    channel?.removeEventListener('message', receive); channel?.close(); channel = undefined;
+    if (supported) { window.removeEventListener('focus', query); document.removeEventListener('visibilitychange', visible); }
+  };
+  const apply = (next: Owner) => {
+    if (owner && compare(next, owner) < 0) return;
+    owner = next; status = next.claimId === self?.claimId ? 'active' : 'inactive';
+    onStatus(status); resolveReady();
+    // Preserve native inactive-tab behaviour: it must not advertise a dead owner's claim.
+    if (status === 'inactive') stopListening();
+  };
+  function receive(event: MessageEvent<Message>) {
+    if (disposed) return;
+    const message = event.data;
+    if (message?.type === 'query') {
+      if (owner) channel?.postMessage({ type: 'owner', owner } satisfies Message);
+    } else if ((message?.type === 'claim' || message?.type === 'owner') && message.owner
+      && typeof message.owner.claimId === 'string' && Number.isFinite(message.owner.claimedAt)) apply(message.owner);
+  }
+  const listen = () => {
+    if (!supported || channel) return;
+    channel = new window.BroadcastChannel(`workflow:active-tab:${workflowId}`);
+    channel.addEventListener('message', receive);
+    window.addEventListener('focus', query); document.addEventListener('visibilitychange', visible);
+  };
+  const claim = () => {
+    if (disposed || status === 'active') return;
+    listen();
+    let tabId: string = crypto.randomUUID();
+    try { tabId = window.sessionStorage.getItem('workflow:tab-id') || tabId; window.sessionStorage.setItem('workflow:tab-id', tabId); } catch { /* Storage is optional. */ }
+    self = { tabId, claimId: crypto.randomUUID(), claimedAt: typeof performance === 'undefined' ? Date.now() : performance.timeOrigin + performance.now() };
+    owner = null; apply(self); channel?.postMessage({ type: 'claim', owner: self } satisfies Message);
+  };
+  listen();
+  if (background && supported) {
+    query();
+    if (!owner) timer = setTimeout(() => { if (!owner && !disposed) claim(); }, 100);
+  } else claim();
+  return { ready, getStatus: () => status, claim,
+    dispose: () => { if (disposed) return; disposed = true; stopListening(); resolveReady(); },
+  };
+}
