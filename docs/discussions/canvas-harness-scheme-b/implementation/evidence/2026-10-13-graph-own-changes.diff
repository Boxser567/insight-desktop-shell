+import type { Context } from '@deepseek-ai/cordis'
+import { defineTool } from '@deepseek-ai/dsh-tools'
+import { CanvasAgentError } from '../shared/canvas-agent-protocol'
+import { parseBridgeOperation } from '../shared/canvas-bridge-protocol'
+import { canvasAddress, type CanvasId } from '../shared/protocol'
+import type { CanvasHostBridge } from './canvas-bridge'
+import { argumentsObject, canvasToolOutput, dispatchCanvasWrite, idOf, reject, requestId, sessionOf } from './canvas-tools'
+
+/** Graph editing and model discovery extend the native service; no generation is registered. */
+export function registerCanvasGraphTools(ctx: Context, bridge: CanvasHostBridge): void {
+  ctx.tools.register(defineTool({
+    name: 'canvas_edges', timeoutMs: 90000,
+    description: '编辑真实画布连线并保存，不移动节点、不执行生成。add连接sourceNodeId/targetNodeId，端口省略时使用原生合法默认；delete删除edgeIds；reconnect用edgeId调整端点，保留原边ID；reorder对targetNodeId的全部入边提供完整edgeIds顺序，只调整该目标输入顺序。先canvas_get(view:graph)核对真实ID/端口/允许输入，不能把outputs素材URL当边。允许四类普通节点作为来源连接原生合法目标，包括已有工具的输入；禁止工具本体作为来源，禁止修改工具到产物的内部管理边；组不支持。expectedVersion取最新confirmed版本。saved才表示保存完成；submission_unknown先权威读取，不能自动重复写。',
+    parameters: {
+      canvasId: { type: 'string', required: true, description: '已有画布ID，正Long十进制字符串。' },
+      expectedVersion: { type: 'string', required: true, description: '最新confirmed版本原样传入。' },
+      action: { type: 'string', required: true, enum: ['add', 'delete', 'reconnect', 'reorder'] },
+      connection: { type: 'object', additionalProperties: false, description: '仅add/reconnect；使用真实节点ID。', properties: {
+        sourceNodeId: { type: 'string', required: true }, targetNodeId: { type: 'string', required: true },
+        sourceHandle: { type: 'string', description: '可选真实source端口ID，省略自动解析。' },
+        targetHandle: { type: 'string', description: '可选真实target端口ID，省略自动解析。' },
+      } },
+      edgeId: { type: 'string', description: '仅reconnect，已有真实边ID。' },
+      targetNodeId: { type: 'string', description: '仅reorder，真实目标节点ID。' },
+      edgeIds: { type: 'array', items: { type: 'string' }, description: '仅delete/reorder，1–20个唯一真实边ID；reorder必须包含目标全部入边。' },
+    }, output: canvasToolOutput,
+    async execute(input, exec) {
+      const request = requestId('canvas_edges', exec); let id: CanvasId | undefined
+      try {
+        const args = argumentsObject(input, ['canvasId', 'expectedVersion', 'action', 'connection', 'edgeId', 'edgeIds', 'targetNodeId']); id = idOf(args)
+        const fields = args.action === 'add' ? ['connection'] : args.action === 'delete' ? ['edgeIds'] : args.action === 'reconnect' ? ['edgeId', 'connection'] : args.action === 'reorder' ? ['targetNodeId', 'edgeIds'] : null
+        if (!fields) throw new CanvasAgentError('INVALID_ARGUMENT', '连线操作仅支持add/delete/reconnect/reorder')
+        argumentsObject(args, ['canvasId', 'expectedVersion', 'action', ...fields])
+        const operation = parseBridgeOperation({ action: 'edge.' + args.action, expectedVersion: args.expectedVersion, ...Object.fromEntries(fields.filter(key => key in args).map(key => [key, args[key]])) })
+        return JSON.stringify(await dispatchCanvasWrite(bridge, id, operation, exec, request))
+      } catch (cause) { return JSON.stringify(reject(request, cause, id)) }
+    }
+  }))
+  ctx.tools.register(defineTool({
+    name: 'canvas_models', timeoutMs: 90000,
+    description: '只读当前账号普通image/video生成节点的可用模式、模型与标量参数选项，不打开画布、不修改参数、不生成。modelType/model使用返回的value，勿猜或用label；省略时读取原生可用默认。modeOffset/modelOffset独立分页，limit默认20；任何offset大于0必须传第一页catalogVersion为expectedCatalogVersion，配置变更须重新读取，不混合不同配置页。通过canvas_node_edit(action:configure)保存配置；paramHints依据所选模型的默认父参数组合，不代表已有节点当前选择；configure后用canvas_get(view:nodes)查询该节点实时参数及选项。高级嵌套参数本期不开放。',
+    parameters: {
+      canvasId: { type: 'string', required: true, description: '已有画布ID，正Long十进制字符串。' },
+      nodeType: { type: 'string', required: true, enum: ['image', 'video'] },
+      modelType: { type: 'string', description: '原生真实模式value；省略选原生可用默认。' },
+      model: { type: 'string', description: '当前模式内真实模型value；省略选原生可用默认。' },
+      modeOffset: { type: 'number', description: '非负整数；续页必须带expectedCatalogVersion。' },
+      modelOffset: { type: 'number', description: '非负整数；续页必须带expectedCatalogVersion。' },
+      limit: { type: 'number', description: '各模式/模型页长度1–20整数，默认20。' },
+      expectedCatalogVersion: { type: 'string', description: '第一页catalogVersion；任何offset大于0时必填。' },
+    }, output: canvasToolOutput,
+    async execute(input, exec) {
+      const request = requestId('canvas_models', exec); let id: CanvasId | undefined
+      try {
+        const args = argumentsObject(input, ['canvasId', 'nodeType', 'modelType', 'model', 'modeOffset', 'modelOffset', 'limit', 'expectedCatalogVersion']); id = idOf(args)
+        const operation = parseBridgeOperation({ action: 'canvas.models.read', ...Object.fromEntries(Object.entries(args).filter(([key]) => key !== 'canvasId')) })
+        const target = await bridge.ensureContext(sessionOf(exec), id, 'read', request + ':prepare', exec.signal)
+        const result = await bridge.dispatch(target, request + ':read', operation, exec.signal)
+        return JSON.stringify({ ...result, requestId: request, address: canvasAddress(id), ...(result.status === 'models' ? { source: 'plugin-service' } : {}) })
+      } catch (cause) { return JSON.stringify(reject(request, cause, id)) }
+    }
+  }))
+}
