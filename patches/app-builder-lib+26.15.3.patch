--- a/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh
+++ b/node_modules/app-builder-lib/templates/nsis/include/installUtil.nsh
@@ -206,8 +206,12 @@ Function uninstallOldVersion
     StrCpy $0 "$0 --updated"
   ${endif}
 
-  StrCpy $uninstallerFileNameTemp "$PLUGINSDIR\old-uninstaller.exe"
-  !insertmacro copyFile "$uninstallerFileName" "$uninstallerFileNameTemp"
+  !ifmacrodef customExtractUpgradeUninstaller
+    !insertmacro customExtractUpgradeUninstaller
+  !else
+    StrCpy $uninstallerFileNameTemp "$PLUGINSDIR\old-uninstaller.exe"
+    !insertmacro copyFile "$uninstallerFileName" "$uninstallerFileNameTemp"
+  !endif
 
   # Retry counter
   StrCpy $R5 0
@@ -216,18 +220,27 @@ Function uninstallOldVersion
     IntOp $R5 $R5 + 1
 
     ${if} $R5 > 5
+      !insertmacro DshUpdateLog "legacy-retry-prompt attempt=$R5 result=$R0 directory=$installationDir"
       MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "$(appCannotBeClosed)" /SD IDCANCEL IDRETRY OneMoreAttempt
       Return
     ${endIf}
 
   OneMoreAttempt:
+    !insertmacro DshUpdateLog "legacy-launch attempt=$R5 directory=$installationDir executable=$uninstallerFileNameTemp"
     ExecWait '"$uninstallerFileNameTemp" /S /KEEP_APP_DATA $0 _?=$installationDir' $R0
+    !insertmacro DshUpdateLog "legacy-return result=$R0"
     ifErrors TryInPlace CheckResult
 
     TryInPlace:
+      !ifmacrodef customExtractUpgradeUninstaller
+        ; Never fall back to the known-broken legacy executable.
+        Goto DoesNotExist
+      !endif
+      !insertmacro DshUpdateLog "legacy-launch-error trying-in-place executable=$uninstallerFileName"
       # the execution failed - might have been caused by some group policy restrictions
       # we try to execute the uninstaller in place
       ExecWait '"$uninstallerFileName" /S /KEEP_APP_DATA $0 _?=$installationDir' $R0
+      !insertmacro DshUpdateLog "legacy-in-place-return result=$R0"
       ifErrors DoesNotExist
 
     CheckResult:
